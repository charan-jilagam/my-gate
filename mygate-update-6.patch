diff --git a/backend/routes/push.js b/backend/routes/push.js
new file mode 100644
index 0000000..9008166
--- /dev/null
+++ b/backend/routes/push.js
@@ -0,0 +1,82 @@
+const express = require('express');
+const { body, validationResult } = require('express-validator');
+const User = require('../models/User');
+const { protect } = require('../middleware/auth');
+const { isPushConfigured } = require('../utils/push');
+const { isSmsConfigured } = require('../utils/sms');
+
+const router = express.Router();
+
+// @route   GET /api/push/config
+// @desc    What this server can do (browser push key, SMS) and the user's own choices
+// @access  Private
+router.get('/config', protect, (req, res) => {
+  res.json({
+    success: true,
+    pushEnabled: isPushConfigured(),
+    publicKey: isPushConfigured() ? process.env.VAPID_PUBLIC_KEY : null,
+    smsEnabled: isSmsConfigured(),
+    prefs: { push: req.user.notificationPrefs?.push !== false, sms: req.user.notificationPrefs?.sms !== false }
+  });
+});
+
+// @route   POST /api/push/subscribe
+// @desc    Save this browser so it can receive push notifications
+// @access  Private
+router.post('/subscribe', protect, [
+  body('endpoint').isURL({ require_tld: false }).withMessage('Invalid subscription'),
+  body('keys.p256dh').notEmpty(),
+  body('keys.auth').notEmpty()
+], async (req, res) => {
+  try {
+    const errors = validationResult(req);
+    if (!errors.isEmpty()) return res.status(400).json({ success: false, errors: errors.array() });
+    const { endpoint, keys } = req.body;
+
+    // One entry per browser; replace if it is already saved.
+    await User.updateOne({ _id: req.user.id }, { $pull: { pushSubscriptions: { endpoint } } });
+    await User.updateOne(
+      { _id: req.user.id },
+      { $push: { pushSubscriptions: { $each: [{ endpoint, keys: { p256dh: keys.p256dh, auth: keys.auth } }], $slice: -5 } } }
+    );
+    res.status(201).json({ success: true, message: 'Notifications are on for this device' });
+  } catch (error) {
+    console.error('Push subscribe error:', error);
+    res.status(500).json({ success: false, message: 'Server error' });
+  }
+});
+
+// @route   POST /api/push/unsubscribe
+// @access  Private
+router.post('/unsubscribe', protect, [body('endpoint').notEmpty()], async (req, res) => {
+  try {
+    await User.updateOne({ _id: req.user.id }, { $pull: { pushSubscriptions: { endpoint: req.body.endpoint } } });
+    res.json({ success: true, message: 'Notifications are off for this device' });
+  } catch (error) {
+    console.error('Push unsubscribe error:', error);
+    res.status(500).json({ success: false, message: 'Server error' });
+  }
+});
+
+// @route   PUT /api/push/prefs
+// @desc    Turn SMS or push on or off for this account
+// @access  Private
+router.put('/prefs', protect, [
+  body('sms').optional().isBoolean(),
+  body('push').optional().isBoolean()
+], async (req, res) => {
+  try {
+    const errors = validationResult(req);
+    if (!errors.isEmpty()) return res.status(400).json({ success: false, errors: errors.array() });
+    const set = {};
+    if (req.body.sms !== undefined) set['notificationPrefs.sms'] = req.body.sms === true || req.body.sms === 'true';
+    if (req.body.push !== undefined) set['notificationPrefs.push'] = req.body.push === true || req.body.push === 'true';
+    if (Object.keys(set).length) await User.updateOne({ _id: req.user.id }, { $set: set });
+    res.json({ success: true, message: 'Preferences saved' });
+  } catch (error) {
+    console.error('Prefs error:', error);
+    res.status(500).json({ success: false, message: 'Server error' });
+  }
+});
+
+module.exports = router;
diff --git a/backend/routes/uploads.js b/backend/routes/uploads.js
new file mode 100644
index 0000000..1e9b760
--- /dev/null
+++ b/backend/routes/uploads.js
@@ -0,0 +1,78 @@
+const express = require('express');
+const crypto = require('crypto');
+const fs = require('fs');
+const path = require('path');
+const multer = require('multer');
+const { protect } = require('../middleware/auth');
+
+const router = express.Router();
+
+const UPLOAD_DIR = path.join(__dirname, '..', 'uploads');
+const MAX_BYTES = 5 * 1024 * 1024;
+
+const upload = multer({
+  storage: multer.memoryStorage(),
+  limits: { fileSize: MAX_BYTES, files: 1 }
+});
+
+// Work out the real image type from the first bytes, not from what the client claims.
+const sniff = (buf) => {
+  if (buf.length < 12) return null;
+  if (buf[0] === 0xff && buf[1] === 0xd8 && buf[2] === 0xff) return { ext: 'jpg', mime: 'image/jpeg' };
+  if (buf.slice(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))) return { ext: 'png', mime: 'image/png' };
+  if (buf.slice(0, 4).toString('ascii') === 'GIF8') return { ext: 'gif', mime: 'image/gif' };
+  if (buf.slice(0, 4).toString('ascii') === 'RIFF' && buf.slice(8, 12).toString('ascii') === 'WEBP') return { ext: 'webp', mime: 'image/webp' };
+  return null;
+};
+
+const cloudinaryReady = () => !!(process.env.CLOUDINARY_CLOUD_NAME && process.env.CLOUDINARY_API_KEY && process.env.CLOUDINARY_API_SECRET);
+
+const toCloudinary = (buffer, folder) =>
+  new Promise((resolve, reject) => {
+    const cloudinary = require('cloudinary').v2;
+    cloudinary.config({
+      cloud_name: process.env.CLOUDINARY_CLOUD_NAME,
+      api_key: process.env.CLOUDINARY_API_KEY,
+      api_secret: process.env.CLOUDINARY_API_SECRET,
+      secure: true
+    });
+    cloudinary.uploader
+      .upload_stream({ folder, resource_type: 'image' }, (err, result) => (err ? reject(err) : resolve(result)))
+      .end(buffer);
+  });
+
+// @route   POST /api/uploads
+// @desc    Upload one image (field name "file"). Returns its URL.
+// @access  Private
+router.post('/', protect, (req, res) => {
+  upload.single('file')(req, res, async (err) => {
+    if (err) {
+      const message = err.code === 'LIMIT_FILE_SIZE' ? 'That image is larger than 5 MB.' : 'The upload failed. Try again.';
+      return res.status(400).json({ success: false, message });
+    }
+    try {
+      if (!req.file) return res.status(400).json({ success: false, message: 'Choose an image to upload.' });
+      const type = sniff(req.file.buffer);
+      if (!type) return res.status(400).json({ success: false, message: 'Only JPG, PNG, GIF or WebP images are allowed.' });
+
+      const name = String(req.file.originalname || 'image').replace(/[^\w.\- ]/g, '').slice(0, 80) || 'image';
+
+      if (cloudinaryReady()) {
+        const result = await toCloudinary(req.file.buffer, `mygate/${req.user.societyId || 'platform'}`);
+        return res.status(201).json({ success: true, url: result.secure_url, name });
+      }
+
+      // No Cloudinary keys: keep files on this server's disk. Fine for development;
+      // many hosts wipe the disk on redeploy, so configure Cloudinary for production.
+      fs.mkdirSync(UPLOAD_DIR, { recursive: true });
+      const file = `${crypto.randomBytes(16).toString('hex')}.${type.ext}`;
+      fs.writeFileSync(path.join(UPLOAD_DIR, file), req.file.buffer);
+      res.status(201).json({ success: true, url: `/uploads/${file}`, name });
+    } catch (e) {
+      console.error('Upload error:', e.message);
+      res.status(500).json({ success: false, message: 'Could not save the image.' });
+    }
+  });
+});
+
+module.exports = router;
