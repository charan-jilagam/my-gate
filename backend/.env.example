# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
# Local:
MONGODB_URI=mongodb://localhost:27017/mygate
# MongoDB Atlas (online, free tier). Replace USER, PASSWORD and the cluster host from Atlas > Connect > Drivers.
# Keep "/mygate" before the "?" so your data goes into a database named mygate.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mygate?retryWrites=true&w=majority&appName=Cluster0

# JWT. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production refuses to start with a short or example value.
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Email (Nodemailer). Used for the sign-up verification code and password reset. Free with a Gmail account:
# turn on 2-step verification, then create an App password at https://myaccount.google.com/apppasswords
# and paste it as EMAIL_PASS. (Brevo, Mailtrap or any other SMTP service works the same way.)
# Leave these empty while developing and the code is printed in the backend terminal instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM_NAME=Nivora

# Mobile number verification (OTP by SMS). No Twilio needed.
# SMS_PROVIDER picks who delivers the code:
#   console  - prints the code in the backend terminal. Free, for development. (default)
#   2factor  - https://2factor.in  (India, OTP API). Needs TWOFACTOR_API_KEY.
#   fast2sms - https://www.fast2sms.com  (India, OTP route). Needs FAST2SMS_API_KEY.
#   twilio   - optional, uses the TWILIO_* values further down.
# Check each service for its current free credits and pricing before you rely on it.
SMS_PROVIDER=console
# TWOFACTOR_API_KEY=
# TWOFACTOR_TEMPLATE=
# FAST2SMS_API_KEY=
SMS_DEFAULT_COUNTRY_CODE=+91
# Ask for a mobile code at sign-up? auto = yes when a real SMS gateway is set up (or while developing), no otherwise.
# Email is always verified. Use true or false to force it.
OTP_REQUIRE_PHONE=auto

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Web push (generate with: npx web-push generate-vapid-keys). Optional.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Twilio. Optional and only needed for SMS alerts or SMS_PROVIDER=twilio.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Razorpay Payment Gateway (Optional - leave empty for development without payments)
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend URL (for CORS and email links). Several origins can be separated by commas.
FRONTEND_URL=http://localhost:5173
